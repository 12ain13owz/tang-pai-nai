# Same behaviour as web/vercel.json + web/middleware.js, for the local Docker run.
server {
  listen 80;
  root /usr/share/nginx/html;

  # /api/* goes to the API with the /api prefix stripped (one origin: the refresh cookie stays
  # first-party). The trailing slash on proxy_pass does the stripping.
  location /api/ {
    proxy_pass ${API_UPSTREAM}/;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # The service worker files and index.html are always revalidated (new versions show up).
  location ~ ^/(ngsw-worker\.js|ngsw\.json|safety-worker\.js|worker-basic\.min\.js|index\.html)$ {
    add_header Cache-Control "no-cache";
  }

  # Client-side routes fall back to the app shell.
  location / {
    try_files $uri $uri/ /index.html;
  }
}
