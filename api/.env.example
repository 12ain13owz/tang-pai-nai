# Template of .env.dev and .env.staging (`npm run setup-env` makes both, and adds to them any
# variable added here later). The values below are for development; "Staging:" lines say what the
# staging file needs instead. Production's values live only in Vercel. Full list: docs/env.md
PORT="3000"
NODE_ENV="development"
BASE_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000,http://localhost:4000,http://localhost:4200"
LOG_LEVEL_CONSOLE="debug"
LOG_LEVEL_FILE="info"
LOG_LEVEL_ERROR_FILE="error"
LOG_SILENT="false"
# false on Vercel (read-only filesystem): logs go to the console only, which Vercel collects
LOG_FILE_ENABLED="true"
SHUTDOWN_TIMEOUT_MS="10000"
# Outgoing messages (core/notification). No API keys needed in dev.
# EMAIL_PROVIDER: console (print to stdout, dev only) | smtp (needs SMTP_URL, e.g. Mailpit smtp://localhost:1025)
# Staging: EMAIL_PROVIDER="smtp", SMTP_URL="smtps://resend:<Resend API key>@smtp.resend.com:465"
# (resend.com → API Keys, one key per environment), EMAIL_FROM on the domain verified in Resend.
EMAIL_PROVIDER="console"
EMAIL_FROM="Tang Pai Nai <no-reply@localhost>"
SMTP_URL=""
# SMS_PROVIDER: console (print to stdout, dev only) | disabled (sending fails with 503)
# Staging: "disabled" until an SMS provider is chosen.
SMS_PROVIDER="console"

# Database (Drizzle + libsql). Local SQLite file in dev.
# Staging: `turso db show tang-pai-nai-staging --url` (libsql://…) and
# `turso db tokens create tang-pai-nai-staging`.
DATABASE_URL="file:./data/local.db"
DATABASE_AUTH_TOKEN=""

# Auth (docs/features/auth.md). JWT_SECRET / OTP_PEPPER are filled with random values by
# `npm run setup-env`; never reuse them between environments.
# Staging: WEB_ORIGIN = the web's develop URL on Vercel, BASE_URL = the API's (Docker replaces both
# with localhost:8081 when it runs the file).
WEB_ORIGIN="http://localhost:4200"
TRUST_PROXY_HOPS="1"
JWT_SECRET=""
OTP_PEPPER=""
# false closes sign-up (existing users still sign in)
SIGNUP_ENABLED="true"
# global cap on sign-in emails per day
EMAIL_DAILY_LIMIT="100"
# global cap on SMS (phone sign-in codes) per day
SMS_DAILY_LIMIT="100"
# New passwords are checked against Have I Been Pwned (k-anonymity, no key). hibp | off.
# HIBP_API_URL can point at a local stand-in; when it's unreachable the check fails open.
PASSWORD_BREACH_CHECK="hibp"
HIBP_API_URL="https://api.pwnedpasswords.com"
# Google sign-in (OIDC). Off unless both are set (the endpoints answer 404, the web hides the
# button). For local testing run `npm run dev:oidc` and use GOOGLE_CLIENT_ID="dev-client",
# GOOGLE_CLIENT_SECRET="dev-secret", GOOGLE_ISSUER="http://localhost:4400".
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_ISSUER="https://accounts.google.com"
# Cloudflare Turnstile bot check on sign-in that sends mail / SMS or checks a password (auth rule
# 32). Off unless both are set.
# Dev: Cloudflare's test keys (a mock, any host): site "1x00000000000000000000AA" + secret
# "1x0000000000000000000000000000000AA" always pass, secret "2x0000000000000000000000000000000AA"
# always fails. Staging: its own widget (Cloudflare → Turnstile), hostnames = the web's develop
# URL and localhost. Never the test keys on staging or production: every bot would pass.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Scheduled cleanups (GET /auth/cleanup, GET /sync/cleanup; Vercel Cron sends it as a bearer).
# Empty: the routes answer 404 (run `npm run auth:cleanup` / `sync:cleanup` by hand instead).
# Staging: `openssl rand -base64 48` (at least 32 characters).
CRON_SECRET=""
