PORT="3000"
NODE_ENV="development"
BASE_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000,http://localhost:4000,http://localhost:4200"
LOG_LEVEL_CONSOLE="debug"
LOG_LEVEL_FILE="info"
LOG_LEVEL_ERROR_FILE="error"
LOG_SILENT="false"
SHUTDOWN_TIMEOUT_MS="10000"
# Outgoing messages (core/notification). No API keys needed in dev.
# EMAIL_PROVIDER: console (print to stdout, dev only) | smtp (needs SMTP_URL, e.g. Mailpit smtp://localhost:1025)
EMAIL_PROVIDER="console"
EMAIL_FROM="Tang Pai Nai <no-reply@localhost>"
SMTP_URL=""
# SMS_PROVIDER: console (print to stdout, dev only) | disabled (sending fails with 503)
SMS_PROVIDER="console"

# Database (Drizzle + libsql). Local SQLite file in dev; Turso URL + token in prod.
DATABASE_URL="file:./data/local.db"
DATABASE_AUTH_TOKEN=""

# Auth (docs/features/auth.md). JWT_SECRET / OTP_PEPPER are filled with random values by
# `npm run setup-env`; never reuse them between environments.
WEB_ORIGIN="http://localhost:4200"
TRUST_PROXY_HOPS="1"
JWT_SECRET=""
OTP_PEPPER=""
# false closes sign-up (existing users still sign in)
SIGNUP_ENABLED="true"
# global cap on sign-in emails per day
EMAIL_DAILY_LIMIT="100"
# New passwords are checked against Have I Been Pwned (k-anonymity, no key). hibp | off.
# HIBP_API_URL can point at a local stand-in; when it's unreachable the check fails open.
PASSWORD_BREACH_CHECK="hibp"
HIBP_API_URL="https://api.pwnedpasswords.com"
# Google sign-in (OIDC). Off unless both are set (the endpoints answer 404, the web hides the
# button). For local testing run `npm run dev:oidc` and use GOOGLE_CLIENT_ID="dev-client",
# GOOGLE_CLIENT_SECRET="dev-secret", GOOGLE_ISSUER="http://localhost:4400".
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_ISSUER="https://accounts.google.com"
